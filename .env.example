# Discord Bot Environment Variables

# Required
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-client-id
GUILD_ID=your-guild-id
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Optional Settings (you can leave empty if not used)
BOT_PREFIX=`
MOD_LOG_CHANNEL_ID=your-mod-log-channel-id
MUTED_ROLE_ID=your-muted-role-id
STAFF_ROLE_IDS=roleId1,roleId2,roleId3
TICKET_CATEGORY_ID=your-ticket-category-id
TRANSCRIPT_CHANNEL_ID=your-transcript-channel-id
